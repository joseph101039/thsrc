// Grafana Alloy config — scrape thsrc-server /metrics 並透過 remote_write
// 推到 Grafana Cloud Hosted Prometheus。
//
// 環境變數(由 docker-compose env_file 注入):
//   GRAFANA_PROM_URL    e.g. https://prometheus-prod-XX.grafana.net/api/prom/push
//   GRAFANA_PROM_USER   instance ID(純數字)
//   GRAFANA_PROM_TOKEN  Grafana Cloud token(glc_...)
//   METRICS_TOKEN       本機 server 的 /metrics Bearer token
//
// 設計取捨:
// - scrape server (8081) 與 scheduler (8082) 兩個 process,不收 host / cAdvisor
//   (P1 階段先求穩,active series 控制在 200 內,Grafana Cloud free tier 充裕)
// - external_labels 加 env=prod / cluster=gce-uswest1 方便未來 multi-env 使用
// - scrape interval 30s — 降低 remote_write 頻率，減少 Grafana Cloud 429 風險

prometheus.scrape "thsrc_server" {
  targets = [
    {
      __address__ = "server:8081",
      job         = "thsrc-server",
      instance    = "gce-uswest1",
    },
  ]
  metrics_path    = "/metrics"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  // Bearer token 帶入 server 的 /metrics
  authorization {
    type        = "Bearer"
    credentials = sys.env("METRICS_TOKEN")
  }

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// Scheduler 是獨立 process(自己的 prom-client registry),
// booking duration / captcha solve / status counter 都在它身上 — 必須單獨 scrape
prometheus.scrape "thsrc_scheduler" {
  targets = [
    {
      __address__ = "scheduler:8082",
      job         = "thsrc-scheduler",
      instance    = "gce-uswest1",
    },
  ]
  metrics_path    = "/metrics"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  authorization {
    type        = "Bearer"
    credentials = sys.env("METRICS_TOKEN")
  }

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// Host metrics — e2-micro VM 上限 1GB RAM,需監控 memory/CPU/disk 飽和狀況。
// prometheus.exporter.unix 透過 mount /proc /sys /(rootfs) 讀 host 資料,
// docker-compose 已加 bind mount。
// 只啟用必要 collectors 控制 active series(meminfo+cpu+filesystem+loadavg+diskstats ~50 個)。
prometheus.exporter.unix "host" {
  rootfs_path = "/host/root"
  sysfs_path  = "/host/sys"
  procfs_path = "/host/proc"

  // 預設 collector 上百個 — 顯式列舉所需子集,避免 series 暴漲
  set_collectors = ["meminfo", "cpu", "filesystem", "loadavg", "diskstats"]

  // filesystem collector 排除 docker overlay / tmpfs 等虛擬掛載,只看 rootfs / data volume
  filesystem {
    mount_points_exclude = "^/(dev|proc|sys|var/lib/docker/.+|run|host/(dev|proc|sys|run))($|/)"
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
  }
}

// 把 exporter targets 加上 job=host + instance=gce-uswest1 label
discovery.relabel "host_metrics" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    action        = "replace"
    target_label  = "job"
    replacement   = "host"
  }
  rule {
    action        = "replace"
    target_label  = "instance"
    replacement   = "gce-uswest1"
  }
}

prometheus.scrape "host_metrics" {
  targets         = discovery.relabel.host_metrics.output
  scrape_interval = "30s"  // host 變動不需 15s,30s 省一半 series ingest
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_PROM_USER")
      password = sys.env("GRAFANA_PROM_TOKEN")
    }
  }

  external_labels = {
    env     = "prod",
    cluster = "gce-uswest1",
  }
}
